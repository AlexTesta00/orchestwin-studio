{
  "name": "orchestwin-studio",
  "author": "Alex Testa",
  "type": "module",
  "description": "Human-governed multi-agent platform for end-to-end Agentic UCD workflows.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "prepare": "husky",
    "commitlint": "commitlint --verbose",
    "install:python": "python -m pip install --disable-pip-version-check --editable . --requirement requirements-dev.txt",
    "install:frontend": "npm --prefix frontend ci --no-audit --no-fund",
    "start:api": "python -m orchestwin.api.server",
    "dev:frontend": "npm --prefix frontend run dev",
    "preview:frontend": "npm --prefix frontend run preview",
    "test": "python -m pytest -m \"not integration\"",
    "test:integration:python": "python -m pytest -m integration src/test/python/integration",
    "test:frontend": "npm --prefix frontend run test",
    "test:all": "npm run test && npm run test:frontend",
    "test:coverage:python": "python -m pytest -m \"not integration\" --cov=orchestwin --cov-branch --cov-report=",
    "test:coverage:integration:python": "python -m pytest -m integration src/test/python/integration --cov=orchestwin --cov-branch --cov-append --cov-report=term-missing --cov-report=xml:coverage.xml",
    "test:compose": "python scripts/smoke_compose.py",
    "test:web-fixtures": "python -m pytest -q src/test/python/web_execution/test_profile_fixture_matrix.py",
    "test:jvm-fixtures": "python -m pytest -q src/test/python/jvm_execution/test_generation_fixtures.py src/test/python/jvm_execution/test_complete_fixture_matrix.py src/test/python/jvm_execution/test_ci_contracts.py",
    "verify:web-runners": "python scripts/verify_web_runner_manifest.py",
    "verify:jvm-runners": "python scripts/verify_jvm_runner_manifest.py",
    "type-check:frontend": "npm --prefix frontend run type-check",
    "lint:python": "python -m ruff check .",
    "lint:fix:python": "python -m ruff check . --fix",
    "lint:frontend": "npm --prefix frontend run lint",
    "format:python": "python -m ruff format .",
    "format:python:check": "python -m ruff format --check .",
    "format:frontend": "npm --prefix frontend run format",
    "format:frontend:check": "npm --prefix frontend run format:check",
    "check:python": "npm run lint:python && npm run format:python:check",
    "quality:frontend": "npm --prefix frontend run quality",
    "check:frontend": "npm --prefix frontend run check",
    "check:renovate": "renovate-config-validator --strict",
    "check:config": "node --check commitlint.config.mjs && node --check release.config.mjs && npm run check:renovate",
    "build:python": "python scripts/build_backend.py",
    "bundle:frontend": "npm --prefix frontend run bundle",
    "build:frontend": "npm --prefix frontend run build",
    "build": "npm run check:python && npm run build:python && npm run check:config",
    "build:all": "npm run build && npm run build:frontend",
    "verify:frontend": "npm run quality:frontend && npm run bundle:frontend",
    "verify:all": "npm run build && npm run verify:frontend",
    "check": "npm run test && npm run build",
    "check:all": "npm run check && npm run check:frontend",
    "release": "semantic-release",
    "verify:jvm-execution-contracts": "python scripts/verify_jvm_execution_contracts.py --repository-root ."
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.9",
    "@semantic-release/release-notes-generator": "14.1.1",
    "husky": "9.1.7",
    "renovate": "44.41.1",
    "semantic-release": "25.0.9"
  }
}
