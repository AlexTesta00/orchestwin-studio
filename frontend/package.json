{
  "name": "@orchestwin/frontend",
  "version": "0.0.0",
  "author": "Alex Testa",
  "type": "module",
  "description": "Vue frontend for OrchesTwin Studio.",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  },
  "scripts": {
    "dev": "vite",
    "type-check:app": "vue-tsc --noEmit --project tsconfig.json",
    "type-check:node": "tsc --noEmit --project tsconfig.node.json",
    "type-check": "npm run type-check:app && npm run type-check:node",
    "test": "vitest run",
    "test:watch": "vitest",
    "build-only": "vite build",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "check": "npm run test && npm run build"
  },
  "dependencies": {
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.4",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  }
}