{
  "name": "@orchestwin/frontend",
  "version": "0.0.0",
  "author": "Alex Testa",
  "type": "module",
  "description": "Vue frontend for OrchesTwin Studio.",
  "license": "Apache-2.0",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "26.6.0",
    "npm": ">=11.18.0 <12"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.6.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.18.0 <= 12.0.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "vite",
    "lint": "eslint src vite.config.ts eslint.config.mjs prettier.config.mjs --max-warnings=0",
    "lint:fix": "eslint src vite.config.ts eslint.config.mjs prettier.config.mjs --fix --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" index.html vite.config.ts eslint.config.mjs prettier.config.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" index.html vite.config.ts eslint.config.mjs prettier.config.mjs",
    "type-check:app": "vue-tsc --noEmit --project tsconfig.json",
    "type-check:node": "tsc --noEmit --project tsconfig.node.json",
    "type-check": "npm run type-check:app && npm run type-check:node",
    "quality": "npm run lint && npm run format:check && npm run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "build-only": "vite build",
    "bundle": "npm run build-only",
    "build": "npm run type-check && npm run bundle",
    "preview": "vite preview",
    "check": "npm run quality && npm run test && npm run bundle"
  },
  "dependencies": {
    "pinia": "4.0.3",
    "vue": "3.5.41",
    "vue-i18n": "11.4.8",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@tsconfig/node24": "24.0.5",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.10"
  }
}