{
  "design_alternative_id": "3d1c9a5e-4b7f-4f0e-9c2a-8e6b1f2d4a01",
  "title": "Registro prestiti della Biblioteca di quartiere Sant'Ambrogio",
  "requirement_codes": ["REQ-001", "REQ-002", "REQ-003", "REQ-004", "REQ-005", "REQ-006"],
  "visual_choices": {
    "archetype": "DASHBOARD",
    "hue_family": "TEAL",
    "color_scheme": "COMPLEMENTARY",
    "color_mode": "LIGHT",
    "saturation": "BALANCED",
    "surface_tone": "COOL",
    "heading_family": "GROTESQUE_SANS",
    "body_family": "HUMANIST_SANS",
    "type_scale": "REGULAR",
    "heading_case": "SENTENCE",
    "heading_weight": "SEMIBOLD",
    "corners": "SOFT",
    "density": "COMFORTABLE",
    "buttons": "FILLED",
    "inputs": "BOXED",
    "elevation": "SUBTLE",
    "borders": "HAIRLINE",
    "navigation": "TOP_BAR",
    "header": "COMPACT_BAR",
    "background": "PLAIN",
    "emphasis": "BALANCED",
    "tone": "CIVIC"
  },
  "styles": [
    ".topbar{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:var(--vl-gap);padding:10px 32px;background:var(--vl-color-surface);border-bottom:var(--vl-border-width) solid var(--vl-color-border)}",
    ".brand{display:flex;align-items:center;gap:10px}",
    ".brand-name{margin:0;font-family:var(--vl-font-heading);font-weight:var(--vl-heading-weight);font-size:1.05rem;letter-spacing:var(--vl-heading-tracking)}",
    ".main-nav ul{display:flex;gap:4px;margin:0 0 0 24px;padding:0;list-style:none}",
    ".main-nav a{display:inline-flex;align-items:center;min-height:44px;padding:0 14px;border-radius:var(--vl-radius-control);color:var(--vl-color-text-muted);font-weight:600;text-decoration:none}",
    ".main-nav a:hover{background:var(--vl-color-surface-alt);color:var(--vl-color-text)}",
    ".main-nav a[aria-current=page]{background:var(--vl-color-primary-soft);color:var(--vl-color-text)}",
    ".operator{display:flex;align-items:center;gap:10px;margin:0 0 0 auto;color:var(--vl-color-text-muted);font-size:.9rem}",
    ".avatar{display:inline-grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--vl-color-accent);color:var(--vl-color-on-accent);font-size:.8rem;font-weight:700}",
    ".page{display:grid;gap:28px;max-width:1180px;margin:0 auto;padding:32px}",
    ".page-narrow{max-width:1040px}",
    ".page-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px}",
    ".eyebrow{margin:0 0 6px;color:var(--vl-color-text-muted);font-size:.85rem;font-weight:600;letter-spacing:.02em}",
    "h1,h2{margin:0;font-family:var(--vl-font-heading);font-weight:var(--vl-heading-weight);text-transform:var(--vl-heading-transform);font-variant:var(--vl-heading-variant);letter-spacing:var(--vl-heading-tracking)}",
    "h1{font-size:var(--vl-size-display);line-height:1.15}",
    "h2{font-size:1.1rem;line-height:1.3}",
    ".lead{max-width:62ch;margin:10px 0 0;color:var(--vl-color-text-muted)}",
    ".button{display:inline-flex;align-items:center;justify-content:center;min-height:var(--vl-control-height);padding:0 20px;border:var(--vl-border-width) solid transparent;border-radius:var(--vl-radius-control);font-weight:700;text-decoration:none;white-space:nowrap}",
    ".button-primary{background:var(--vl-color-primary);color:var(--vl-color-on-primary);box-shadow:var(--vl-shadow)}",
    ".button-primary:hover{background:color-mix(in srgb, var(--vl-color-primary) 88%, var(--vl-color-text))}",
    ".button-quiet{background:transparent;color:var(--vl-color-text);border-color:var(--vl-color-border)}",
    ".kpis{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:var(--vl-gap)}",
    ".kpi{display:grid;gap:4px;padding:18px 20px;background:var(--vl-color-surface);border:var(--vl-border-width) solid var(--vl-color-border);border-radius:var(--vl-radius-panel);box-shadow:var(--vl-shadow)}",
    ".kpi h2{font-family:var(--vl-font-body);font-size:.9rem;font-weight:600;color:var(--vl-color-text-muted)}",
    ".kpi-value{margin:4px 0 0;font-size:2.1rem;font-weight:700;line-height:1.1;font-variant-numeric:tabular-nums}",
    ".kpi-note{margin:0;color:var(--vl-color-text-muted);font-size:.85rem}",
    ".kpi-alert{border-color:var(--vl-color-danger)}",
    ".kpi-alert .kpi-value{color:var(--vl-color-danger)}",
    ".panel{display:grid;gap:18px;padding:24px;background:var(--vl-color-surface);border:var(--vl-border-width) solid var(--vl-color-border);border-radius:var(--vl-radius-panel);box-shadow:var(--vl-shadow)}",
    ".panel-head{display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:16px}",
    ".filters{display:flex;flex-wrap:wrap;gap:12px}",
    ".field{display:grid;gap:6px}",
    ".field label{color:var(--vl-color-text-muted);font-size:.85rem;font-weight:600}",
    "input,select,textarea{min-height:var(--vl-control-height);padding:0 12px;font:inherit;color:var(--vl-color-text);background:var(--vl-color-surface);border:1px solid var(--vl-color-text-muted);border-radius:var(--vl-radius-control)}",
    "textarea{padding:10px 12px;line-height:1.5;resize:vertical}",
    ".loans{width:100%;border-collapse:collapse;font-size:.95rem}",
    ".loans caption{padding-bottom:12px;color:var(--vl-color-text-muted);font-size:.9rem;text-align:left}",
    ".loans th{padding:10px 12px;border-bottom:2px solid var(--vl-color-border);color:var(--vl-color-text-muted);font-size:.78rem;letter-spacing:.05em;text-align:left;text-transform:uppercase}",
    ".loans td{padding:14px 12px;border-bottom:1px solid var(--vl-color-border);vertical-align:middle}",
    ".loans tbody tr:hover td{background:var(--vl-color-surface-alt)}",
    ".loans tfoot td{border-bottom:0;color:var(--vl-color-text-muted);font-size:.85rem}",
    ".muted{display:block;color:var(--vl-color-text-muted);font-size:.8rem}",
    ".badge{display:inline-flex;align-items:center;padding:4px 10px;border-radius:999px;font-size:.8rem;font-weight:700;white-space:nowrap}",
    ".badge-danger{background:var(--vl-color-danger-soft);color:var(--vl-color-danger)}",
    ".badge-warning{background:var(--vl-color-primary-soft);color:var(--vl-color-text)}",
    ".badge-success{background:var(--vl-color-success-soft);color:var(--vl-color-success)}",
    ".row-action{display:inline-flex;align-items:center;min-height:36px;padding:0 14px;border:1px solid var(--vl-color-border);border-radius:var(--vl-radius-control);background:var(--vl-color-surface);color:var(--vl-color-text);font:inherit;font-weight:600;text-decoration:none;cursor:pointer}",
    ".row-action:hover{border-color:var(--vl-color-primary)}",
    ".breadcrumb ol{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0;list-style:none;color:var(--vl-color-text-muted);font-size:.9rem}",
    ".breadcrumb li+li::before{content:\"/\";margin-right:8px}",
    ".breadcrumb a{color:var(--vl-color-text);font-weight:600}",
    ".layout-two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.35fr);gap:24px;align-items:start}",
    ".facts{display:grid;grid-template-columns:max-content 1fr;gap:10px 18px;margin:0}",
    ".facts dt{color:var(--vl-color-text-muted);font-weight:600}",
    ".facts dd{margin:0}",
    ".notice{margin:0;padding:12px 14px;border-radius:var(--vl-radius-control);font-weight:600}",
    ".notice-danger{background:var(--vl-color-danger-soft);color:var(--vl-color-danger)}",
    ".notice-success{background:var(--vl-color-success-soft);color:var(--vl-color-success)}",
    ".channels{display:grid;gap:4px;margin:0;padding:10px 16px;border:1px solid var(--vl-color-border);border-radius:var(--vl-radius-control)}",
    ".channels legend{padding:0 6px;font-weight:600}",
    ".check{display:flex;align-items:center;gap:10px;min-height:44px}",
    ".check input{width:20px;height:20px;min-height:0;accent-color:var(--vl-color-primary)}",
    ".actions{display:flex;flex-wrap:wrap;gap:12px}",
    ".result{display:grid;justify-items:start;gap:14px}",
    ".steps{display:grid;gap:10px;margin:0;padding-left:22px}",
    ".site-footer{max-width:1180px;margin:0 auto;padding:8px 32px 40px;color:var(--vl-color-text-muted);font-size:.85rem}",
    "@media (max-width:960px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}.layout-two{grid-template-columns:1fr}.topbar{flex-wrap:wrap;padding:10px 16px}.main-nav ul{margin:0}}",
    "@media (max-width:600px){.page{padding:20px 16px}.kpis{grid-template-columns:1fr}.loans thead{display:none}.loans tr{display:grid;gap:4px;padding:12px 0;border-bottom:1px solid var(--vl-color-border)}.loans td{padding:2px 0;border:0}}"
  ],
  "screens": [
    {"code": "SCR-001", "title": "Prestiti in corso", "state": "DEFAULT", "markup": "library-loans.scr-001.html"},
    {"code": "SCR-002", "title": "Invia un sollecito", "state": "DEFAULT", "markup": "library-loans.scr-002.html"},
    {"code": "SCR-003", "title": "Sollecito inviato", "state": "SUCCESS", "markup": "library-loans.scr-003.html"}
  ]
}
