  "styles": [
    ".topbar{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px;max-width:760px;margin:0 auto;padding:20px 24px 0}",
    ".brand{margin:0;font-family:var(--vl-font-heading);font-weight:var(--vl-heading-weight);letter-spacing:var(--vl-heading-tracking)}",
    ".help{margin:0;color:var(--vl-color-text-muted);font-size:.9rem}",
    ".wizard{display:grid;gap:20px;max-width:760px;margin:0 auto;padding:24px}",
    ".stepper ol{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;margin:0;padding:0;list-style:none}",
    ".step{display:flex;align-items:center;gap:10px;min-height:48px;padding:6px 12px;border-radius:var(--vl-radius-control);background:var(--vl-color-surface);color:var(--vl-color-text-muted);font-size:.92rem;font-weight:600}",
    ".step-current{background:var(--vl-color-primary-soft);color:var(--vl-color-text)}",
    ".step-number{display:inline-grid;place-items:center;width:28px;height:28px;border-radius:50%;background:var(--vl-color-surface-alt);color:var(--vl-color-text);font-size:.85rem;font-weight:700}",
    ".step-current .step-number{background:var(--vl-color-primary);color:var(--vl-color-on-primary)}",
    ".step-done .step-number{background:var(--vl-color-success-soft);color:var(--vl-color-success)}",
    ".card{display:grid;gap:16px;padding:32px;background:var(--vl-color-surface);border:var(--vl-border-width) solid var(--vl-color-border);border-radius:var(--vl-radius-panel);box-shadow:var(--vl-shadow)}",
    ".card-success{border-color:var(--vl-color-success)}",
    ".eyebrow{margin:0;color:var(--vl-color-text-muted);font-size:.85rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase}",
    "h1,h2{margin:0;font-family:var(--vl-font-heading);font-weight:var(--vl-heading-weight);letter-spacing:var(--vl-heading-tracking)}",
    "h1{font-size:var(--vl-size-display);line-height:1.15}",
    "h2{font-size:1.15rem;line-height:1.3}",
    ".lead{max-width:60ch;margin:0;color:var(--vl-color-text-muted)}",
    ".form{display:grid;gap:18px}",
    ".section-title{padding-top:12px;border-top:1px solid var(--vl-color-border)}",
    ".grid-2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}",
    ".field{display:grid;gap:6px}",
    ".field label{font-weight:600}",
    "input,select{min-height:var(--vl-control-height);padding:0 14px;font:inherit;color:var(--vl-color-text);background:var(--vl-color-surface-alt);border:1px solid var(--vl-color-text-muted);border-radius:var(--vl-radius-control)}",
    ".hint{margin:0;color:var(--vl-color-text-muted);font-size:.85rem}",
    ".choices{display:grid;gap:10px;margin:0;padding:0;border:0}",
    ".choices legend{margin-bottom:6px;padding:0;font-weight:700}",
    ".choice{display:flex;align-items:flex-start;gap:12px;padding:14px 16px;border:1px solid var(--vl-color-border);border-radius:var(--vl-radius-control);background:var(--vl-color-surface-alt);color:var(--vl-color-text)}",
    ".choice input,.check input{width:20px;height:20px;min-height:0;margin-top:2px;accent-color:var(--vl-color-primary)}",
    ".choice-body{display:grid;gap:2px}",
    ".check{display:flex;align-items:center;gap:12px;min-height:44px}",
    ".actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:12px;padding-top:8px}",
    ".button{display:inline-flex;align-items:center;justify-content:center;min-height:var(--vl-control-height);padding:0 22px;border:1px solid transparent;border-radius:var(--vl-radius-control);font-weight:700;text-decoration:none}",
    ".button-primary{background:var(--vl-color-primary);color:var(--vl-color-on-primary)}",
    ".button-quiet{background:transparent;color:var(--vl-color-text);border-color:var(--vl-color-border)}",
    ".summary{display:grid;gap:12px;padding:18px 20px;border-radius:var(--vl-radius-control);background:var(--vl-color-surface-alt);color:var(--vl-color-text)}",
    ".summary-head{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px}",
    ".edit-link{display:inline-flex;align-items:center;min-height:44px;color:var(--vl-color-text);font-weight:700}",
    ".facts{display:grid;grid-template-columns:minmax(0,11rem) 1fr;gap:8px 16px;margin:0}",
    ".facts dt{color:var(--vl-color-text-muted)}",
    ".facts dd{margin:0;font-weight:600}",
    ".notice{margin:0;padding:14px 16px;border-radius:var(--vl-radius-control);font-weight:600}",
    ".notice-success{background:var(--vl-color-success-soft);color:var(--vl-color-success)}",
    ".success-icon{justify-self:start}",
    ".next-steps{display:grid;gap:10px;margin:0;padding-left:22px}",
    "@media (max-width:640px){.wizard{padding:16px}.card{padding:20px}.grid-2{grid-template-columns:1fr}.stepper ol{grid-template-columns:1fr}.actions{justify-content:stretch}.button{flex:1 1 auto}}",
    "@media (prefers-reduced-motion:no-preference){.button{transition:background-color .2s ease}}"
  ],
