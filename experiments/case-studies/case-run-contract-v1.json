    "case_content_hash",
    "workflow_run_id",
    "platform_commit",
    "execution_profile",
    "environment_identity_hash",
    "started_at",
    "completed_at",
    "status",
    "evidence",
    "measurement",
    "notes",
    "real_user_behavior_validated",
    "empirical_user_evidence_created",
